NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4321
DATABASE_URL=postgresql://mcsr:mcsr_local_password@localhost:5432/mcsr_sabinsk
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-32-character-random-secret
SESSION_COOKIE_NAME=mcsr_admin_session

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mcsr-sabinsk
S3_ACCESS_KEY=mcsr
S3_SECRET_KEY=mcsr_local_password
S3_PUBLIC_BASE_URL=http://localhost:9000/mcsr-sabinsk
S3_ALLOW_PUBLIC_READ=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-seeding
SEED_DEMO=false
