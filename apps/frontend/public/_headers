/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self' http://localhost:3000; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob: http://localhost:9000 https://mc-heads.net; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable
