---
import "@/styles/global.css"
import "@/styles/public-shell.css"
import "@/styles/public-competition.css"
import "@/styles/public-details.css"
import "@/styles/public-timeline.css"
import "@/styles/public-states-responsive.css"
import "@/styles/playoff.css"

interface Props {
  title: string
  description: string
  activePage?: "tournaments" | "rules"
}

const { title, description, activePage = "tournaments" } = Astro.props
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101619" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="MCSR Сабинск — главная">
        <span class="brand-mark">MS</span>
        <span class="brand-name">MCSR Сабинск</span>
      </a>
      <nav class="main-nav" aria-label="Основная навигация">
        <a
          class:list={["nav-link", activePage === "rules" && "nav-link-active"]}
          href="/rules"
          aria-current={activePage === "rules" ? "page" : undefined}
        >
          Правила
        </a>
        <a
          class:list={[
            "nav-link",
            activePage === "tournaments" && "nav-link-active",
          ]}
          href="/"
          aria-current={activePage === "tournaments" ? "page" : undefined}
        >
          Турниры
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
